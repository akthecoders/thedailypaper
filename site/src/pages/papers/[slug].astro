---
import { getCollection } from 'astro:content';
import Paper from '../../layouts/Paper.astro';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const papers = await getCollection('papers', ({ data }) => !data.draft);
  return papers.map((paper) => ({
    // Strip the YYYY-MM-DD- date prefix from the slug for cleaner URLs
    params: { slug: paper.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '') },
    props: { paper },
  }));
}

interface Props {
  paper: CollectionEntry<'papers'>;
}

const { paper } = Astro.props;
const { Content } = await paper.render();
---

<Paper paper={paper}>
  <Content />
</Paper>
